# TWise account the server signs in to Ask Data with. The server keeps the session
# and renews it, so the app is always signed in. Changes apply without a restart.
TWISE_EMAIL=
TWISE_PASSWORD=

# TWise hosts. The defaults are the QA environment.
# TWISE_AUTH_URL=http://20.98.112.250:7007
# TWISE_API_URL=http://20.98.112.250:5069/api

# Port for the Express API server (default 8787)
# API_PORT=8787
